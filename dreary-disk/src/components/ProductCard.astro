---
import { Product } from '../models/Product';

interface Props {
  product: Product;
}

const { product }: Props = Astro.props;
---

<div
  class="product-card bg-white rounded-lg shadow-md overflow-hidden border border-gray-100 flex flex-col justify-between"
  data-in-stock={product.getProductInStock() ? "true" : "false"}
>
  <div>
    <div class="relative aspect-square w-full overflow-hidden bg-gray-100 rounded-t-lg">
      <img 
        src={product.image} 
        alt={product.title} 
        class="w-full h-full object-cover"
      />
      {!product.inStock && (
        <span class="absolute top-2 right-2 bg-red-500 text-white text-xs font-bold px-2 py-1 rounded">
          Out of Stock
        </span>
      )}
    </div>
    
    <div class="p-4">
      <span class="text-xs uppercase tracking-wider text-amber-600 font-semibold">
        {product.category}
      </span>
      <h3 class="text-lg font-bold mt-1 text-gray-800">
        {product.title}
      </h3>
      <p class="text-gray-600 text-sm mt-2 line-clamp-2">
        {product.description}
      </p>
    </div>
  </div>

  <div class="p-4 pt-0 flex justify-between items-center border-t border-gray-50 mt-4">
    <span class="text-xl font-bold text-gray-900">
      ${product.price}
    </span>

    <a 
      href={`/products/${product.slug}`}
      class="inline-block bg-amber-700 hover:bg-amber-800 text-white text-sm font-medium px-4 py-2 rounded transition"
    >
      View Details
    </a>
  </div>
</div>
