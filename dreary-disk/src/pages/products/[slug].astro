---
import Layout from '../../layouts/Layout.astro';
import { ProductCatalog } from '../../models/ProductCatalog';
import productsData from '../../data/products.json';
const catalog = new ProductCatalog(productsData);


export function getStaticPaths(){
    return new ProductCatalog(productsData).getAllProducts().map(product => ({
       params: {slug: product.slug}
    }));
}

const product = catalog.getProductBySlug(Astro.params.slug);
if(!product){
    return Astro.redirect('/');
}
---


<Layout title={product.title}>    
    <div class="bg-white rounded-lg shadow-md overflow-hidden border border-gray-100 flex flex-col justify-between">
        <div>
          <div class="relative aspect-square w-full overflow-hidden bg-gray-100 rounded-t-lg">
            <img 
              src={product.image} 
              alt={product.title} 
              class="w-full h-full object-cover"
            />
            {!product.inStock && (
              <span class="absolute top-2 right-2 bg-red-500 text-white text-xs font-bold px-2 py-1 rounded">
                Out of Stock
              </span>
            )}
          </div>
          
          <div class="p-4">
            <span class="text-xs uppercase tracking-wider text-amber-600 font-semibold">
              {product.category}
            </span>
            <h1 class="text-lg font-bold mt-1 text-gray-800">
              {product.title}
            </h1>

          </div>
        </div>
      
        <div class="p-4 pt-0 flex justify-between items-center border-t border-gray-50 mt-4">
          <span class="text-xl font-bold text-gray-900">
            {product.getProductPrice()}
          </span>
        </div>
        <div class="p-4">
            <h3 class="text-lg font-bold mt-1 text-gray-800">About the Product</h3>
            <p class="text-sm text-gray-900">
                {product.description}
            </p>
        </div>
        <div class="flex justify-end">
            <a class="text-sm text-gray-900 mb-4 mr-4" href="/">Go back to the home</a>
        </div>
      </div>
      
</Layout>