---
import '../styles/global.css'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
		<script src="https://cdn.tailwindcss.com"></script>
	</head>
	<body class="bg-gray-50 text-gray-900 flex flex-col">
		<header class="bg-white border-b border-gray-200 py-4 px-6 shadow-sm">
			<div class="max-w-7xl mx-auto flex justify-between items-center">
				<a href="/" class="text-2xl font-bold tracking-tight text-amber-700">Jewelry Store</a>
			</div>
		</header>

		<main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
			<slot />
		</main>

		<footer class="bg-white border-t border-gray-200 py-6 text-center text-sm text-gray-500">
			&copy; 2026 Jewelry Store. All rights reserved.
		</footer>
		
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
